# OpenAI API Key (for script generation)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API Key (alternative for script generation)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Replicate API Key (for image/video generation)
REPLICATE_API_KEY=your_replicate_key_here

# Stability AI API Key (optional - for image generation)
STABILITY_API_KEY=your_stability_key_here

# Configuration
DEFAULT_VIDEO_DURATION=30
DEFAULT_IMAGE_STYLE=cinematic
OUTPUT_LANGUAGE=urdu
